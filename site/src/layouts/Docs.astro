---
import themeInit from '../../../dist/theme-init.js?url';
import pkg from '../../../package.json';
import Search from '../components/Search.astro';
import SideNav from '../components/SideNav.astro';
import { groupOf, hrefFor, neighbours } from '../lib/nav';
import '../styles/docs.css';

interface Props {
  title: string;
  description: string;
  /** Current page slug under /ui/ ('' for the index). */
  slug: string;
  toc?: { id: string; label: string }[];
  /** Extra stylesheet under the base, e.g. 'foundations.css'. */
  extraCss?: string;
  /** Page draws its own heading block (404): no crumb, title, lede or pager. */
  bare?: boolean;
}
const {
  title,
  description,
  slug,
  toc = [],
  extraCss,
  bare = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
// The crumb is the page kicker. When the group and the title are the same
// word (Changelog), show that one item instead of "Changelog / Changelog".
const group = groupOf(slug)?.label ?? 'Docs';
const crumb = !slug ? 'Docs' : group === title ? title : `${group} / ${title}`;
const { prev, next } = neighbours(slug);
const canonical = new URL(
  hrefFor(base, slug),
  Astro.site ?? 'https://luismatute.me',
).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Blocking and external (CSP script-src 'self'): sets html[data-mode] from the shared lm-mode cookie before first paint. -->
    <script is:inline src={themeInit} data-lm-theme data-cookie-domain=".luismatute.me"></script>
    <meta name="color-scheme" content="light dark" />
    <title>{slug ? `${title} · @luismatute/ui` : '@luismatute/ui docs'}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {extraCss && <link rel="stylesheet" href={`${base}${extraCss}`} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="head">
      <button class="menu" type="button" popovertarget="drawer" aria-label="Open navigation">
        <svg viewBox="0 0 22 22" aria-hidden="true"><path d="M3 6h16M3 11h16M3 16h10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path></svg>
      </button>
      <a class="brand" href={base}>luismatute<b>/ui</b></a>
      <span class="ver" title="@luismatute/ui version">v{pkg.version}</span>
      <!-- Hidden until scripts/search.ts runs: without JS there is no search to open. -->
      <button class="search-open" type="button" hidden data-search-open aria-haspopup="dialog" aria-controls="search" aria-keyshortcuts="Control+K Meta+K /">
        <svg viewBox="0 0 22 22" aria-hidden="true"><circle cx="9.5" cy="9.5" r="6" fill="none" stroke="currentColor" stroke-width="2.5"></circle><path d="M14 14l5 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path></svg>
        <span class="search-label">Search</span>
        <kbd class="search-kbd" aria-hidden="true" data-search-kbd>Ctrl K</kbd>
      </button>
      <!-- Hidden until scripts/theme-switch.ts runs; without JS theme-init still applies the saved mode. -->
      <fieldset class="theme-switch" hidden data-theme-switch>
        <legend class="sr">Theme</legend>
        <button type="button" data-mode-set="day" aria-pressed="false">Day</button>
        <button type="button" data-mode-set="night" aria-pressed="false">Night</button>
      </fieldset>
      <a class="head-ext" href="https://github.com/pipa/luismatute-ui">GitHub</a>
      <a class="head-ext head-site" href="https://luismatute.me">luismatute.me</a>
    </header>
    <div id="drawer" class="drawer" popover>
      <div class="drawer-top">
        <span class="brand" aria-hidden="true">luismatute<b>/ui</b></span>
        <button class="menu" type="button" popovertarget="drawer" popovertargetaction="hide" aria-label="Close navigation">
          <svg viewBox="0 0 22 22" aria-hidden="true"><path d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path></svg>
        </button>
      </div>
      <SideNav current={slug} label="Docs (drawer)" />
    </div>
    <div class="shell">
      <aside class="side">
        <SideNav current={slug} label="Docs" />
      </aside>
      <main id="main" class="main" tabindex="-1">
        <article class="prose" data-pagefind-body={bare ? undefined : ''}>
          {toc.length > 0 && (
            <details class="toc-inline" data-pagefind-ignore>
              <summary>On this page</summary>
              <nav aria-label="On this page">
                <ul>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ul>
              </nav>
            </details>
          )}
          {!bare && <p class="crumb" data-pagefind-ignore>{crumb}</p>}
          {!bare && <h1>{title}</h1>}
          {!bare && <p class="lede">{description}</p>}
          <slot />
          {!bare && <nav class="pager" aria-label="Previous and next page" data-pagefind-ignore>
            {prev ? <a class="prev" href={hrefFor(base, prev.slug)}><small>Previous</small><strong>{prev.label}</strong></a> : <span></span>}
            {next && <a class="next" href={hrefFor(base, next.slug)}><small>Next</small><strong>{next.label}</strong></a>}
          </nav>}
        </article>
      </main>
      <aside class="toc" aria-label="On this page">
        {toc.length > 0 && (
          <>
            <p>On this page</p>
            <ul>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ul>
          </>
        )}
      </aside>
    </div>
    <Search />
    <p id="copy-live" class="sr" aria-live="polite"></p>
    <script>
      // Called here, not as a side-effect import: package.json "sideEffects"
      // would let the bundler drop a bare import.
      import { initCopy } from '../scripts/copy';
      import { initTokenCopy } from '../scripts/token-copy';
      import { initSearch } from '../scripts/search';
      import { initToc } from '../scripts/toc';
      import { initThemeSwitch } from '../scripts/theme-switch';

      initCopy();
      initTokenCopy();
      // Live demos only load the component code on pages that have one.
      if (document.querySelector('.demo')) void import('../scripts/demos').then((m) => m.initDemos());
      initToc();
      initSearch();
      initThemeSwitch();
    </script>
  </body>
</html>
