---
/**
 * Docs search (design/docs-shell SPEC.md "Search dialog"). A native modal
 * <dialog>, a combobox input and a listbox of Pagefind results; the logic is in
 * scripts/search.ts, which loads /ui/pagefind/pagefind.js only when it opens.
 * Without JS the dialog never opens and the header pill stays hidden.
 */
---

<dialog id="search" class="search-dialog" aria-labelledby="search-title" data-search>
  <div class="search-panel">
    <p class="search-kicker" id="search-title">Search the docs</p>
    <div class="search-bar">
      <input
        id="search-input"
        class="search-input"
        type="search"
        role="combobox"
        aria-label="Search pages"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search pages"
        enterkeyhint="go"
      />
      <button type="button" class="search-close" data-search-close aria-label="Close search">
        <svg viewBox="0 0 22 22" aria-hidden="true"><path d="M6 6l10 10M16 6L6 16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <div id="search-results" class="search-hits" role="listbox" aria-label="Results" hidden></div>
    <div class="search-empty" data-search-empty hidden>
      <p class="search-hand">no flights found</p>
      <p data-search-empty-hint>Try a component name, a token, or install.</p>
    </div>
    <p class="sr" role="status" data-search-status></p>
  </div>
</dialog>
