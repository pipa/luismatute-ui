---
interface Props {
  id: string;
  level?: 2 | 3;
}
const { id, level = 2 } = Astro.props;
const Tag = `h${level}` as const;
const text = (await Astro.slots.render('default'))
  .replace(/<[^>]+>/g, '')
  .trim();
---

<Tag id={id}><slot /> <a class="anchor" href={`#${id}`} aria-label={`Link to ${text}`}>#</a></Tag>
