---
import Docs from '../layouts/Docs.astro';
import { hrefFor } from '../lib/nav';

const base = import.meta.env.BASE_URL;
const toc = [
  { id: 'what-is-here', label: 'What is here' },
  { id: 'start', label: 'Start' },
];
---

<Docs
  slug=""
  title="@luismatute/ui"
  description="The design system behind luismatute.me: tokens, web components and the Wheels up illustration kit."
  toc={toc}
>
  <h2 id="what-is-here">What is here <a class="anchor" href="#what-is-here" aria-label="Link to What is here">#</a></h2>
  <p>
    Every page in the sidebar covers one part of the package: how to install it, the
    <code>--lm-*</code> tokens, one page per component, the SVG kit and the changelog.
  </p>
  <h2 id="start">Start <a class="anchor" href="#start" aria-label="Link to Start">#</a></h2>
  <p>
    New here? Begin with <a href={hrefFor(base, 'getting-started/install-from-a-tag')}>Install from a tag</a>.
  </p>
</Docs>
